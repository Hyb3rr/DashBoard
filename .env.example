# geo DB
MAXMIND_CITY_DB=/Users/ngaphan/Documents/Workspace/VAULT/01-Subject/Practice/4._Real_Web/ip-intelligence/data/GeoLite2-City.mmdb
MAXMIND_ASN_DB=/Users/ngaphan/Documents/Workspace/VAULT/01-Subject/Practice/4._Real_Web/ip-intelligence/data/GeoLite2-ASN.mmdb

# Log stream
LOGS_BEHAVIOR_LOOKBACK_HOURS=24
LOG_WS_ENABLED=true
LOG_WS_URL=
LOG_WS_TOKEN={your token}
LOG_WS_LOG_KEY=
LOG_WS_SOURCE_ID=

# AI things
LOG_WS_AI_SCORE_INTERVAL_SECONDS=300
LOG_WS_AI_TRAIN_INTERVAL_SECONDS=21600
LOG_WS_AI_TRAIN_LOOKBACK_HOURS=168
LOG_WS_AI_SCORE_LOOKBACK_HOURS=24
LOG_WS_AI_MIN_IP_WINDOWS=3
LOG_WS_AI_EXPIRE_HOURS=24
AI_MODEL_PATH=data/models/isolation_forest_v1.joblib
STALE_HOURS=72
PRIVACY_REFRESH_BATCH=100
PRIVACY_REFRESH_SCHEDULER=true

# Local privacy/threat intelligence updater
DEVICEBROWSERINFO_API_KEY=
DEVICEBROWSERINFO_CSV_URL=
AZ0_VPN_MANIFEST_URL=https://raw.githubusercontent.com/az0/vpn_ip/main/data/get_addresses_via_api.json
X4B_VPN_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt
X4B_DATACENTER_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/datacenter/ipv4.txt
CLOUDFLARE_IPS_URL=https://api.cloudflare.com/client/v4/ips
FIREHOL_LISTS=firehol_proxies,firehol_anonymous,dm_tor,et_tor,firehol_webserver,abuseipdb_1d,abuseipdb_30d,dshield,feodo,dronebl_auto_botnets,sslbl,zeus,palevo
INTEL_UPDATE_LOCK_PATH=data/intel_updater.lock
INTEL_UPDATER_ENABLED=false
# When true, Uvicorn starts one non-blocking due-source refresh in the background.
INTEL_AUTO_UPDATE_ON_STARTUP=false
INTEL_UPDATE_CONCURRENCY=6
ENRICHMENT_BATCH_SIZE=20
ENRICHMENT_CONCURRENCY=4
BUCKET_TRIM_INTERVAL_SECONDS=1800

# Global network-location snapshots
GEO_RIR_REFRESH_ENABLED=true
GEOFEED_SOURCES=
RIR_APNIC_URL=https://ftp.apnic.net/stats/apnic/delegated-apnic-extended-latest
RIR_RIPE_URL=https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-extended-latest
RIR_ARIN_URL=https://ftp.arin.net/pub/stats/arin/delegated-arin-extended-latest
RIR_LACNIC_URL=https://ftp.lacnic.net/pub/stats/lacnic/delegated-lacnic-extended-latest
RIR_AFRINIC_URL=https://ftp.afrinic.net/pub/stats/afrinic/delegated-afrinic-extended-latest
GEO_REEVALUATION_TTL_DAYS=14
GEO_PYASN_DB_PATH=data/geo/pyasn.dat

# Telegram alerts (disabled by default)
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=3600
