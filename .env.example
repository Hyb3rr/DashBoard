# geo DB
MAXMIND_CITY_DB=data/GeoLite2-City.mmdb
MAXMIND_ASN_DB=data/GeoLite2-ASN.mmdb

# Log stream
LOGS_BEHAVIOR_LOOKBACK_HOURS=24
LOG_WS_ENABLED=true
LOG_WS_URL=
LOG_WS_TOKEN={your token}
LOG_WS_LOG_KEY=
LOG_WS_SOURCE_ID=

# AI things
# AI Stage-2 runtime schedule
AI_RUNTIME_ENABLED=true
AI_RUNTIME_INTERVAL_SECONDS=300
LOG_WS_AI_TRAIN_LOOKBACK_HOURS=168
AI_TRAIN_MAX_WINDOWS=100000
AI_TRAIN_MAX_IPS=10000
AI_TRAIN_N_JOBS=2
RETENTION_CLEANUP_ENABLED=false
CHANGE_LOG_RETENTION_ENABLED=true
PRIVACY_HISTORY_CLEANUP_ENABLED=false
PRIVACY_HISTORY_RETENTION_DAYS=180
LOG_WS_AI_SCORE_LOOKBACK_HOURS=24
LOG_WS_AI_MIN_IP_WINDOWS=3
LOG_WS_AI_EXPIRE_HOURS=24
AI_MODEL_PATH=data/models/isolation_forest_v1.joblib
LOCAL_REASONING_BASE_URL=http://127.0.0.1:8081/v1/chat/completions
LOCAL_REASONING_TIMEOUT_SECONDS=180
LOCAL_REASONING_MAX_TOKENS=768
# Local CPU reasoning eligibility budget. 0 (missing/invalid/negative) fails closed and abstains.
# A positive value N permits inference only when estimated input tokens are <= N.
LOCAL_REASONING_MAX_INPUT_TOKENS=0
LOCAL_REASONING_PORT=8081
LLAMA_SERVER_BIN=llama-server
FOUNDATION_SEC_MODEL_PATH=
FOUNDATION_SEC_MODEL_NAME=Foundation-Sec-8B-Reasoning
FOUNDATION_SEC_CONTEXT_SIZE=8192
FOUNDATION_SEC_GPU_LAYERS=0
FOUNDATION_SEC_THREADS=6
FOUNDATION_SEC_READY_ATTEMPTS=180
FOUNDATION_SEC_LOG_PATH=data/foundation-sec-llama-server.log
AI_EXPLAIN_WORKER_ENABLED=true
AI_EXPLAIN_PACKETS_PATH=data/ai/corpora/foundation-sec-real.json
AI_EXPLAIN_POLL_INTERVAL_SECONDS=2
AI_EXPLAIN_STALE_AFTER_SECONDS=225

# Independent macOS LaunchAgent; it runs at login and on this interval.
# Installing/writing the plist does not load it into launchd.
DATA_SCHEDULER_ENABLED=true
DATA_SCHEDULER_INTERVAL_SECONDS=3600
SAPICS_UPDATER_ENABLED=true
SAPICS_REFRESH_HOURS=24
IP2REGION_UPDATER_ENABLED=true
IP2REGION_REFRESH_HOURS=24
COMTRADE_MIRROR_REFRESH=true
# Shared intelligence refresh is opt-in; SAPICS has an independent fallback schedule.
INTEL_UPDATER_ENABLED=false

# Market/geography refresh
COMTRADE_API_KEY=
COMTRADE_FURNITURE_EXPORT_REFRESH=false
MARKET_SOURCES_REFRESH=false
MARKET_SOURCES_REFRESH_DAYS=30
FX_RATE_API_URL=https://api.exchangerate.host/historical
FX_RATE_API_KEY=
# FAOSTAT Forestry Sawnwood (item 1872), official bulk resource.
FAOSTAT_FORESTRY_API_URL=https://api.data.apps.fao.org/api/v2/bigquery?download=true&item_code=1872&sql_url=https%3A%2F%2Fdata.apps.fao.org%2Fcatalog%2Fdataset%2F2fc50fb3-5e9d-4d5e-98a8-a38e73509412%2Fresource%2F8385adbf-821c-4b1c-b14d-f067dd8016c7%2Fdownload%2Ffo-forestry-production-and-trade.query.sql
# ILOSTAT earnings: annual, total sex, USD; wildcard is five dimensions.
ILOSTAT_WAGES_API_URL=https://sdmx.ilo.org/rest/data/ILO,DF_EAR_EMTA_SEX_CUR_NB,1.0/.....?startPeriod=2020&format=jsondata
BGS_CEMENT_API_URL=https://ogcapi.bgs.ac.uk/collections/world-mineral-statistics/items?f=json&limit=10000&erml_group=Cement
GEOGRAPHY_REFRESH=true
GHSL_CITY_GLOBAL_URL=
GEO_CANDIDATE_MODE=vn
GEO_CANDIDATE_PRIORITY_COUNTRY=VN
GEO_CANDIDATE_PRIORITY_CITY_LIMIT=30
STALE_HOURS=72
PRIVACY_REFRESH_BATCH=100
PRIVACY_REFRESH_SCHEDULER=true

# Local privacy/threat intelligence updater
DEVICEBROWSERINFO_API_KEY=
DEVICEBROWSERINFO_CSV_URL=
TOR_EXIT_LIST_REFRESH_HOURS=1
TOR_EXIT_LIST_URL=https://check.torproject.org/torbulkexitlist
TOR_EXIT_LIST_IP1_URL=https://ip1.info/tor-ips/tor-ips.txt
AZ0_VPN_MANIFEST_URL=https://raw.githubusercontent.com/az0/vpn_ip/main/data/get_addresses_via_api.json
X4B_VPN_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt
X4B_DATACENTER_LIST_URL=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/datacenter/ipv4.txt
CLOUDFLARE_IPS_URL=https://api.cloudflare.com/client/v4/ips
FIREHOL_LISTS=firehol_proxies,firehol_anonymous,dm_tor,et_tor,firehol_webserver,abuseipdb_1d,abuseipdb_30d,dshield,feodo,dronebl_auto_botnets,sslbl,zeus,palevo
INTEL_UPDATE_LOCK_PATH=data/intel_updater.lock
# When true, Uvicorn starts one non-blocking due-source refresh in the background.
INTEL_AUTO_UPDATE_ON_STARTUP=false
INTEL_UPDATE_CONCURRENCY=6
ENRICHMENT_BATCH_SIZE=20
ENRICHMENT_CONCURRENCY=4
BUCKET_TRIM_INTERVAL_SECONDS=1800

# Global network-location snapshots
GEO_RIR_REFRESH_ENABLED=true
GEOFEED_SOURCES=
RIR_APNIC_URL=https://ftp.apnic.net/stats/apnic/delegated-apnic-extended-latest
RIR_RIPE_URL=https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-extended-latest
RIR_ARIN_URL=https://ftp.arin.net/pub/stats/arin/delegated-arin-extended-latest
RIR_LACNIC_URL=https://ftp.lacnic.net/pub/stats/lacnic/delegated-lacnic-extended-latest
RIR_AFRINIC_URL=https://ftp.afrinic.net/pub/stats/afrinic/delegated-afrinic-extended-latest
GEO_REEVALUATION_TTL_DAYS=14
GEO_PYASN_DB_PATH=data/geo/pyasn.dat

# Telegram alerts (disabled by default)
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=3600
# Split storage: PostgreSQL state + ClickHouse traffic.
DATA_BACKEND=split
# FastAPI process role: all (local default), api, collector, worker, or ai.
# Run the standalone scheduler separately with:
# python -m scripts.ops.data_scheduler
APP_ROLE=all
POSTGRES_DSN=postgresql://ipintel:ipintel@127.0.0.1:5432/ipintel
POSTGRES_POOL_OPEN_TIMEOUT_SECONDS=5
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=ipintel
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false
DATASET_LIVE_ID=live

# Proxy security context is fail-closed. Headers are trusted only from these peers.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
# Reverse-proxy/SSO boundary. Direct clients cannot spoof the identity header.
AUTH_REQUIRED=false
AUTH_IDENTITY_HEADER=X-Forwarded-User
AUTH_ROLE_HEADER=X-Forwarded-Groups
AUTH_TRUSTED_PROXY_CIDRS=
# Comma-separated hostnames accepted by the application (set the public domain in production).
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,test
# Safe response headers are enabled by default. Keep HSTS at the HTTPS reverse proxy.
SECURITY_HEADERS_ENABLED=true

# Off-host backups (optional; never commit real credentials)
BACKUP_STORAGE_BACKEND=azure_blob
BACKUP_AZURE_ACCOUNT=webmonitorforintern
BACKUP_AZURE_CONTAINER=sentinel-backups
